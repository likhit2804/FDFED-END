# UrbanEase Server Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (MongoDB connection string)
# Development: mongodb://localhost:27017/urbanEase
# Production / Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urbanEase?retryWrites=true&w=majority
MONGO_URI1=mongodb://localhost:27017/urbanEase

# JWT Authentication (Required: minimum 32 characters long)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long

# Express Session Secret
SESSION_SECRET=urban-ease-session-secret-change-in-production

# Client Application URL (used for CORS and transactional email links)
# Local: http://localhost:5173
# Production: https://urbanease-client.onrender.com (or your frontend domain)
CLIENT_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email Service (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="UrbanEase Support <no-reply@urbaneaseapp.com>"
EMAIL_FROM_NAME="UrbanEase Support"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Cloudinary (Media storage for images & documents)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Redis Cache (Optional for dev, recommended for production)
REDIS_URL=redis://localhost:6379

# Swagger / API Documentation base URL (Optional, defaults to auto-detection)
# BACKEND_URL=http://localhost:3000
