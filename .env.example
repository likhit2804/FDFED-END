# UrbanEase Root Environment Variables Template

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/urbanEase
MONGO_URI1=mongodb://localhost:27017/urbanEase

# Security
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long
SESSION_SECRET=urban-ease-session-secret-change-in-production

# URLs for CORS & Links
CLIENT_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email Service
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME="UrbanEase Support"
ADMIN_EMAIL=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# Razorpay
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Redis
REDIS_URL=redis://localhost:6379

# Client-side (when using shared env or docker)
VITE_API_BASE_URL=http://localhost:3000
