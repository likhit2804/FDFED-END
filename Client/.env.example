# UrbanEase Client Environment Variables

# Backend API Base URL
# In local development:
#   Leave blank or set to http://localhost:3000 (auto-resolves to http://localhost:3000 on localhost)
# In production:
#   Set to your backend URL, for example: https://urbanease-backend-6gff.onrender.com
VITE_API_BASE_URL=http://localhost:3000

# Optional proxy target for Vite dev server (defaults to http://localhost:3000)
VITE_PROXY_TARGET=http://localhost:3000
